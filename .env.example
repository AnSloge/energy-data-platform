# Copy to .env and fill in. Never commit .env.
# The primary sources (hvakosterstrommen, Open-Meteo, NVE) need no keys.

# Identifies us to free APIs (required by MET Norway, polite for the rest)
HTTP_USER_AGENT=energy-data-platform/0.1 (your-email@example.com)

# Optional sources, see docs/data-sources.md
ENTSOE_API_TOKEN=
FROST_CLIENT_ID=

# Databricks Free Edition
DATABRICKS_HOST=
DATABRICKS_TOKEN=
